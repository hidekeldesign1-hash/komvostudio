# URL de Google Apps Script que recibe Agenda y Quiz.
# Cómo obtenerla: ver docs/GOOGLE_SHEETS_AGENDA.md
GOOGLE_SHEETS_WEBAPP_URL=https://script.google.com/macros/s/XXXXXXXX/exec

# --- Quiz / Assessment Funnel ---
# El diagnóstico se genera en el servidor con las respuestas del quiz.
# No requiere ninguna clave de IA.

# Alternativa opcional: conexión directa mediante una cuenta de servicio.
# No es necesaria si GOOGLE_SHEETS_WEBAPP_URL está configurada.
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=
GOOGLE_SHEET_ID=
# Aliases usados por el quiz original:
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_PRIVATE_KEY=
# GOOGLE_SHEETS_SPREADSHEET_ID=

NEXT_PUBLIC_BOOKING_URL=
NEXT_PUBLIC_WHATSAPP_NUMBER=525532584558
NEXT_PUBLIC_PRIVACY_URL=
